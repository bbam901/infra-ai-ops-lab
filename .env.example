# Gemini API Key (API 키가 없거나 비어있는 경우 룰 기반 진단 보고서가 작성됩니다)
GEMINI_API_KEY=

# Grafana 관리자 로그인 정보
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# 외부 호출 및 진단용 애플리케이션 Base URL
APP_BASE_URL=http://localhost

# 시스템 기본 포트 바인딩 설정
APP_PORT=8001
NGINX_PORT=80
PROMETHEUS_PORT=9090
CADVISOR_PORT=8080
LOKI_PORT=3100
GRAFANA_PORT=3050

# 스크립트 참조용 URL 설정
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
FASTAPI_URL=http://localhost
