# Gemini API key for AI-powered incident diagnosis
# If left empty, the incident reporter script will fallback to rule-based Markdown reports.
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI configurations
APP_PORT=8001
NGINX_PORT=80

# Prometheus & Loki URLs (used by scripts)
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
FASTAPI_URL=http://localhost

# Container host ports configuration
PROMETHEUS_PORT=9090
CADVISOR_PORT=8080
LOKI_PORT=3100
GRAFANA_PORT=3000

